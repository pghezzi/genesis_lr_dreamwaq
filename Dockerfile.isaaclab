# =============================================================================
# LeggedGym-Ex Dockerfile (IsaacSim/IsaacLab)
# =============================================================================
# 构建命令：
#   cd /home/lupinjia
#   docker build -t leggedgym-ex:isaaclab -f LeggedGym-Ex/Dockerfile.isaaclab .
#
# 运行命令：
#   docker run --gpus all -it --rm leggedgym-ex:isaaclab

# ---- 基础镜像 ----
FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

# ---- 复制 uv 工具 ----
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ---- 环境变量 ----
ENV DEBIAN_FRONTEND=noninteractive
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_PREFERENCE=only-managed
ENV UV_HTTP_TIMEOUT=600

# ---- 安装系统依赖 ----
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    libegl-dev \
    libgl1-mesa-glx \
    libglu1-mesa \
    libvulkan-dev \
    vulkan-tools \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    python3-pip \
    bash-completion \
    vim \
    ncurses-bin \
    && rm -rf /var/lib/apt/lists/*

# ---- 配置 PyPI 镜像源 ----
RUN python3 -m pip config set global.index-url \
    https://pypi.tuna.tsinghua.edu.cn/simple
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 安装 Python 3.11 ----
RUN uv python install 3.11

# ---- 创建工作目录 ----
WORKDIR /workspace

# ---- 复制项目源码 ----
COPY LeggedGym-Ex /workspace/LeggedGym-Ex
COPY IsaacLab /workspace/IsaacLab

# ---- 创建并安装 IsaacSim 环境 ----
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /workspace/LeggedGym-Ex && \
    uv venv --python 3.11 .venv && \
    . .venv/bin/activate && \
    uv pip install "isaacsim[all,extscache]==5.1.0" \
        --extra-index-url https://pypi.nvidia.com

# ---- 安装 IsaacLab ----
ENV TERM=xterm
RUN touch /.dockerenv
RUN cd /workspace/IsaacLab && \
    ./isaaclab.sh --install none

# ---- 安装 LeggedGym-Ex 及依赖 ----
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /workspace/LeggedGym-Ex && \
    . .venv/bin/activate && \
    uv pip install matplotlib tensorboard xlsxwriter pandas wandb tqdm scipy numpy pygame trimesh rich-argparse && \
    uv pip install warp-lang==1.12.0 && \
    uv pip install -e . --no-deps

# ---- 配置环境变量 ----
ENV SIMULATOR=isaaclab
ENV PYTHONPATH=/workspace/LeggedGym-Ex:$PYTHONPATH
ENV PATH=/workspace/LeggedGym-Ex/.venv/bin:$PATH

# ---- 默认命令 ----
CMD ["bash"]
