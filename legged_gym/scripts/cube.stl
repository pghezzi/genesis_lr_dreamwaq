solid hollow_cube

  // Outer cube (20mm)
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 20 0 0
      vertex 20 20 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 20 20 0
      vertex 0 20 0
    endloop
  endfacet

  facet normal 0 0 1
    outer loop
      vertex 0 0 20
      vertex 20 20 20
      vertex 20 0 20
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 20
      vertex 0 20 20
      vertex 20 20 20
    endloop
  endfacet

  // Walls (20mm outer, 2mm thick)
  // Front
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 20 0 0
      vertex 20 0 20
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 20 0 20
      vertex 0 0 20
    endloop
  endfacet

  // Back
  facet normal 0 1 0
    outer loop
      vertex 0 20 0
      vertex 20 20 20
      vertex 20 20 0
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 0 20 0
      vertex 0 20 20
      vertex 20 20 20
    endloop
  endfacet

  // Left
  facet normal -1 0 0
    outer loop
      vertex 0 0 0
      vertex 0 0 20
      vertex 0 20 20
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 0 0
      vertex 0 20 20
      vertex 0 20 0
    endloop
  endfacet

  // Right
  facet normal 1 0 0
    outer loop
      vertex 20 0 0
      vertex 20 20 20
      vertex 20 0 20
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 20 0 0
      vertex 20 20 0
      vertex 20 20 20
    endloop
  endfacet

  // Inner cavity (subtracts a 16mm cube)
  // Cavity bottom (not printed)
  // Cavity top (not printed)
  // Walls left open to create hollow interior

endsolid hollow_cube
