# =============================================================================
# LeggedGym-Ex Dockerfile
# =============================================================================
# 本 Dockerfile 从 LeggedGym-Ex 根目录构建。
#
# 构建命令（Genesis 环境）：
#   cd /path/to/LeggedGym-Ex
#   docker build -t leggedgym-ex:genesis -f Dockerfile .
#
# 运行命令：
#   docker run --gpus all -it --rm leggedgym-ex:genesis
#
# 参考文档：
#   https://leggedgym-ex-doc.readthedocs.io/en/latest/user_guide/getting_started/installation.html

# ---- 基础镜像 ----
FROM nvidia/cuda:12.6.3-cudnn-devel-ubuntu22.04

# ---- 复制 uv 工具 ----
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ---- 环境变量 ----
ENV DEBIAN_FRONTEND=noninteractive
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_PREFERENCE=only-managed
ENV UV_HTTP_TIMEOUT=300
ENV SIMULATOR=genesis

# ---- 安装系统依赖 ----
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    libegl-dev \
    libgl1-mesa-glx \
    libglu1-mesa \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    python3-pip \
    bash-completion \
    vim \
    && rm -rf /var/lib/apt/lists/*

# ---- 配置 PyPI 镜像源（加速下载）----
RUN python3 -m pip config set global.index-url \
    https://pypi.tuna.tsinghua.edu.cn/simple
ENV UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 安装 Python ----
# Genesis 要求 Python >= 3.10
RUN uv python install 3.10

# ---- 创建工作目录 ----
WORKDIR /workspace/LeggedGym-Ex

# ---- 复制依赖文件（利用 Docker 缓存层）----
COPY pyproject.toml ./
COPY rsl_rl ./rsl_rl
COPY legged_gym ./legged_gym
COPY resources ./resources

# ---- 先安装依赖 ----
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv && \
    uv pip install torch==2.8.0+cu126 torchvision==0.23.0+cu126 \
        --index-url https://download.pytorch.org/whl/cu126 && \
    uv pip install genesis-world==1.0.0

# ---- 复制项目源码 ----
COPY . .

# ---- 安装项目本身（editable mode）----
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -e .

# ---- 配置环境变量 ----
ENV SIMULATOR=genesis
ENV PYTHONPATH=/workspace/LeggedGym-Ex:$PYTHONPATH
ENV PATH=/workspace/LeggedGym-Ex/.venv/bin:$PATH

# ---- 默认命令 ----
CMD ["bash"]
